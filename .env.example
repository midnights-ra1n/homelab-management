# Dossier de données (base SQLite, icônes, clé). Défaut : ./data
DATA_DIR=./data
# Clé de chiffrement des secrets d'intégration. Défaut : générée dans DATA_DIR/secret.key
APP_SECRET=
# Cookie de session « Secure » (à activer derrière HTTPS)
COOKIE_SECURE=false
# Désactive la connexion intégrée (uniquement derrière un SSO)
AUTH_DISABLED=false

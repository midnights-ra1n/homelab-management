{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/mg/*"
      ],
      "next/link": [
        "./src/mg/next/link.tsx"
      ],
      "next/navigation": [
        "./src/mg/next/navigation.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
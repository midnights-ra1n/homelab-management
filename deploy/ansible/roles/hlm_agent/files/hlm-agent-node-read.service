[Unit]
Description=Midnights Monitoring agent: read the state or logs of the Node.js apps
Documentation=https://github.com/midnights-ra1n/homelab-management

[Service]
Type=oneshot
# Root-owned helper: fixed reads (node-app status, history, logs) and, unless read-only, the
# variables, deploy keys and creation of an app (answered to the hub only); see node-app-helper.sh.
ExecStart=/usr/local/lib/hlm-agent/node-app-helper.sh read
# Creating an app clones its repository.
TimeoutStartSec=12min
Nice=10

# Role management (VM / CT): systemctl enable --now homelab-tools@management
HLT_LISTEN=:3000
# Monitoring and management on the same host: give one of them another port (e.g. :3001).
HLT_PUBLIC_URL=
HLT_TRUSTED_PROXIES=
# To take over homelab-management's data, copy homelab.db, secret.key and uploads/ into
# /var/lib/homelab-tools/management/ (owner homelab-tools) before the first start.

# Role monitoring (VPS): systemctl enable --now homelab-tools@monitoring
HLT_LISTEN=:8080
# Public address (agents install command, CSRF check): https://monitoring.example.fr
HLT_PUBLIC_URL=
# Reverse proxies allowed to set X-Forwarded-For / X-Forwarded-Proto (CIDR, comma separated)
HLT_TRUSTED_PROXIES=
# Push notifications for the iOS / macOS app (docs/API-APPLE.md). The .p8 key must be readable
# by the homelab-tools user: chown homelab-tools: /etc/homelab-tools/apns.p8 && chmod 400 it.
#HLT_APNS_KEY=/etc/homelab-tools/apns.p8
#HLT_APNS_KEY_ID=
#HLT_APNS_TEAM_ID=
#HLT_APNS_TOPIC=

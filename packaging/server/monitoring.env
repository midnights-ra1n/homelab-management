# Role monitoring (VPS): systemctl enable --now homelab-tools@monitoring
HLT_LISTEN=:8080
# Public address (agents install command, CSRF check): https://monitoring.example.fr
HLT_PUBLIC_URL=
# Reverse proxies allowed to set X-Forwarded-For / X-Forwarded-Proto (CIDR, comma separated)
HLT_TRUSTED_PROXIES=
